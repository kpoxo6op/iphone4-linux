+/*
+ * Why the firmware did not come up: the word it replaces at the end of RAM
+ * with a pointer to its shared area, any trap or assert there, and the tail
+ * of its console log. Works without CONFIG_BRCMDBG.
+ */
+static void brcmf_sdio_n90_postmortem(struct brcmf_sdio *bus)
+{
+	struct brcmf_sdio_dev *sdiodev = bus->sdiodev;
+	u32 end = bus->ci->rambase + bus->ci->ramsize;
+	u32 shared, console, buf, size, idx;
+	__le32 w[18];
+	char *text, *line, *next;
+	int err, i;
+
+	err = brcmf_sdiod_ramrw(sdiodev, false, end - 4, (u8 *)w, 4);
+	shared = le32_to_cpu(w[0]);
+	pr_info("brcmfmac n90: last RAM word %#x (%d)\n", shared, err);
+	if (err || shared < bus->ci->rambase || shared >= end - 64) {
+		pr_info("brcmfmac n90: no shared area; the firmware did not get that far\n");
+		return;
+	}
+	err = brcmf_sdiod_ramrw(sdiodev, false, shared, (u8 *)w, 64);
+	if (err)
+		return;
+	pr_info("brcmfmac n90: shared flags %#x trap %#x assert %#x in %#x line %u console %#x\n",
+		le32_to_cpu(w[0]), le32_to_cpu(w[1]), le32_to_cpu(w[2]),
+		le32_to_cpu(w[3]), le32_to_cpu(w[4]), le32_to_cpu(w[5]));
+	if (le32_to_cpu(w[1]) && !brcmf_sdiod_ramrw(sdiodev, false, le32_to_cpu(w[1]),
+						    (u8 *)w + 0, 72))
+		pr_info("brcmfmac n90: trap type %#x epc %#x cpsr %#x spsr %#x r0 %#x r1 %#x r2 %#x r3 %#x r4 %#x r5 %#x r6 %#x r7 %#x\n",
+			le32_to_cpu(w[0]), le32_to_cpu(w[1]), le32_to_cpu(w[2]),
+			le32_to_cpu(w[3]), le32_to_cpu(w[4]), le32_to_cpu(w[5]),
+			le32_to_cpu(w[6]), le32_to_cpu(w[7]), le32_to_cpu(w[8]),
+			le32_to_cpu(w[9]), le32_to_cpu(w[10]), le32_to_cpu(w[11]));
+	err = brcmf_sdiod_ramrw(sdiodev, false, shared, (u8 *)w, 64);
+	console = err ? 0 : le32_to_cpu(w[5]);
+	if (!console || brcmf_sdiod_ramrw(sdiodev, false, console + 8, (u8 *)w, 12))
+		return;
+	buf = le32_to_cpu(w[0]);
+	size = le32_to_cpu(w[1]);
+	idx = le32_to_cpu(w[2]);
+	pr_info("brcmfmac n90: console at %#x, %u bytes, write index %u\n", buf, size, idx);
+	if (!size || size > 16384 || idx >= size)
+		return;
+	text = kzalloc(2 * size + 1, GFP_KERNEL);
+	if (!text)
+		return;
+	/* Oldest first: from the write index to the end, then the start. */
+	if (!brcmf_sdiod_ramrw(sdiodev, false, buf, (u8 *)text + size, size)) {
+		memcpy(text, text + size + idx, size - idx);
+		memcpy(text + size - idx, text + size, idx);
+		text[size] = 0;
+		/* The unwritten part of a young log is zeros. */
+		for (i = 0; i < size; i++)
+			if (text[i] != '\n' && (text[i] < 32 || text[i] > 126))
+				text[i] = text[i] ? ' ' : '\n';
+		for (line = text; line && *line; line = next) {
+			next = strchr(line, '\n');
+			if (next)
+				*next++ = 0;
+			if (*line)
+				pr_info("brcmfmac n90 console: %s\n", line);
+		}
+	}
+	kfree(text);
+}

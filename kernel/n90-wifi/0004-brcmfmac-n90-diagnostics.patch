+/* PMU state while ALP is still forced: is the ILP clock running? */
+static void brcmf_sdio_n90_pmudump(struct brcmf_sdio *bus)
+{
+	static const u16 regs[] = { 0x28, 0x2c, 0x600, 0x604, 0x608, 0x60c,
+				    0x610, 0x614, 0x618, 0x61c, 0x620, 0x624 };
+	struct brcmf_sdio_dev *sdiodev = bus->sdiodev;
+	u32 base = brcmf_chip_get_pmu(bus->ci)->base;
+	u32 t0, t1;
+	int i;
+
+	for (i = 0; i < ARRAY_SIZE(regs); i++)
+		brcmf_err("n90: pmu %#x = %#010x\n", regs[i],
+			  brcmf_sdiod_readl(sdiodev, base + regs[i], NULL));
+	t0 = brcmf_sdiod_readl(sdiodev, base + 0x614, NULL);
+	msleep(100);
+	t1 = brcmf_sdiod_readl(sdiodev, base + 0x614, NULL);
+	brcmf_err("n90: pmutimer %#x -> %#x in 100 ms (ILP ~32 kHz gives ~3277)\n",
+		  t0, t1);
+}
+
+static void brcmf_sdio_n90_ramprobe(struct brcmf_sdio *bus)
+{
+	static const u16 cores[] = { BCMA_CORE_ARM_CM3, BCMA_CORE_80211,
+				     BCMA_CORE_INTERNAL_MEM };
+	static const uint sizes[] = { 4, 64, 128 };
+	struct brcmf_sdio_dev *sdiodev = bus->sdiodev;
+	u8 out[128], in[128];
+	int i, n, err;
+	u8 clk;
+
+	clk = brcmf_sdiod_readb(sdiodev, SBSDIO_FUNC1_CHIPCLKCSR, &err);
+	brcmf_err("n90: rambase %#x ramsize %#x clkcsr %#x (%d)\n",
+		  bus->ci->rambase, bus->ci->ramsize, clk, err);
+	for (i = 0; i < ARRAY_SIZE(cores); i++) {
+		struct brcmf_core *core = brcmf_chip_get_core(bus->ci, cores[i]);
+
+		if (!core)
+			continue;
+		brcmf_err("n90: core %#x rev %u at %#x up %d tmslow %#x tmshigh %#x\n",
+			  core->id, core->rev, core->base,
+			  brcmf_chip_iscoreup(core),
+			  brcmf_sdiod_readl(sdiodev, core->base + 0xf98, NULL),
+			  brcmf_sdiod_readl(sdiodev, core->base + 0xf9c, NULL));
+	}
+	memset(in, 0, sizeof(in));
+	err = brcmf_sdiod_ramrw(sdiodev, false, bus->ci->rambase, in, 4);
+	brcmf_err("n90: read 4 at rambase: %d %*ph\n", err, 4, in);
+	if (err)
+		return;
+	for (i = 0; i < ARRAY_SIZE(sizes); i++) {
+		u32 at = bus->ci->rambase + 0x100 * (i + 1);
+
+		for (n = 0; n < sizes[i]; n++)
+			out[n] = n * 7 + i + 1;
+		err = brcmf_sdiod_ramrw(sdiodev, true, at, out, sizes[i]);
+		brcmf_err("n90: write %u at %#x: %d\n", sizes[i], at, err);
+		if (err)
+			return;
+		memset(in, 0, sizeof(in));
+		err = brcmf_sdiod_ramrw(sdiodev, false, at, in, sizes[i]);
+		brcmf_err("n90: read %u: %d, %s, %*ph\n", sizes[i], err,
+			  memcmp(in, out, sizes[i]) ? "differs" : "matches",
+			  16, in);
+		if (err)
+			return;
+	}
+}

+/* Both ends of the control channel when the dongle stops answering. */
+static void brcmf_sdio_n90_status(struct brcmf_sdio *bus)
+{
+	struct brcmf_sdio_dev *sdiodev = bus->sdiodev;
+	struct brcmf_sdio_count *c = &bus->sdcnt;
+	u32 base = bus->sdio_core->base;
+	u8 iorx, intx, clk;
+	u32 intstatus, mask;
+
+	sdio_claim_host(sdiodev->func1);
+	iorx = brcmf_sdiod_func0_rb(sdiodev, SDIO_CCCR_IORx, NULL);
+	intx = brcmf_sdiod_func0_rb(sdiodev, SDIO_CCCR_INTx, NULL);
+	clk = brcmf_sdiod_readb(sdiodev, SBSDIO_FUNC1_CHIPCLKCSR, NULL);
+	intstatus = brcmf_sdiod_readl(sdiodev, base + SD_REG(intstatus), NULL);
+	mask = brcmf_sdiod_readl(sdiodev, base + SD_REG(hostintmask), NULL);
+	sdio_release_host(sdiodev->func1);
+	pr_info("brcmfmac n90: IORx %#x INTx %#x clkcsr %#x intstatus %#x hostintmask %#x pending %#x\n",
+		iorx, intx, clk, intstatus, mask, atomic_read(&bus->intstatus));
+	pr_info("brcmfmac n90: intr %d poll %d interrupts %u polls %u hdrs %u data %u tx %u ctl tx %lu errs %lu rx %lu errs %lu hdrfail %u badhdr %u\n",
+		bus->intr, bus->poll, c->intrcount, c->pollcnt, c->f2rxhdrs,
+		c->f2rxdata, c->f2txdata, c->tx_ctlpkts, c->tx_ctlerrs,
+		c->rx_ctlpkts, c->rx_ctlerrs, c->rx_hdrfail, c->rx_badhdr);
+	brcmf_sdio_n90_postmortem(bus);
+}

# Applied on top of the backlight kernel's .config for the lean build
# (22 October 2026). The knownboot config is a debug build: lockdep and the
# function tracer made every syscall 10-50x slower on the phone.
# CONFIG_PROVE_LOCKING is not set
# CONFIG_LOCKDEP is not set
# CONFIG_DEBUG_LOCK_ALLOC is not set
# CONFIG_DEBUG_RT_MUTEXES is not set
# CONFIG_DEBUG_SPINLOCK is not set
# CONFIG_DEBUG_MUTEXES is not set
# CONFIG_DEBUG_WW_MUTEX_SLOWPATH is not set
# CONFIG_DEBUG_ATOMIC_SLEEP is not set
# CONFIG_TRACE_IRQFLAGS is not set
# CONFIG_PROVE_RCU is not set
# CONFIG_FTRACE is not set
# CONFIG_FUNCTION_TRACER is not set
# CONFIG_HZ_100 is not set
CONFIG_HZ_1000=y
CONFIG_HZ=1000
CONFIG_INPUT_UINPUT=y

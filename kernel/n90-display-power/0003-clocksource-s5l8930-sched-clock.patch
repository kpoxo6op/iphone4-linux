--- a/drivers/clocksource/s5l8930.c	2025-08-17 03:25:03.000000000 +1200
+++ b/drivers/clocksource/s5l8930.c	2026-10-22 00:53:43.832102748 +1300
@@ -19,6 +19,7 @@
 #include <linux/kernel.h>
 #include <linux/slab.h>
 #include <linux/interrupt.h>
+#include <linux/sched_clock.h>
 
 #include "timer-of.h"
 
@@ -50,6 +51,14 @@
 	return (((uint64_t)hi) << 32) | lo;
 }
 
+static void __iomem *s5l_sched_lo;
+
+/* The low word of the free-running 64-bit counter. Without a registered
+ * sched_clock the kernel falls back to jiffies: 10 ms scheduler accounting. */
+static u64 notrace s5l_sched_read(void) {
+	return readl_relaxed(s5l_sched_lo);
+}
+
 static void s5l_timer0_disable(struct timer_of *tof) {
 	writel(TIMER0_CTRL_UPDATE, timer_of_base(tof) + TIMER0_CTRL);
 	writel(TIMER0_CTRL_STOP,   timer_of_base(tof) + TIMER0_CTRL);
@@ -122,7 +131,8 @@
 
 	s5l_timer0_disable(&tof);
 
-	/* TODO should probably add a sched clock, but I want to understand more about why it's needed first */
+	s5l_sched_lo = timer_of_base(&tof);
+	sched_clock_register(s5l_sched_read, 32, timer_of_rate(&tof));
 
 	clockevents_config_and_register(&tof.clkevt, timer_of_rate(&tof),
 			1, 0xF0000000);

{
  "$schema": "https://opencode.ai/config.json",
  "model": "opencode/deepseek-v4.1-flash-free#max",
  "default_agent": "build",
  "shell": "/home/boris/code/iphone4-linux/harness/sandbox-shell",
  "share": "disabled",
  "update": "disable",
  "snapshots": false,
  "lsp": false,
  "formatter": false,
  "policies": [
    {
      "action": "provider.use",
      "resource": "*",
      "effect": "deny"
    },
    {
      "action": "provider.use",
      "resource": "opencode",
      "effect": "allow"
    }
  ],
  "agents": {
    "build": {
      "model": "opencode/deepseek-v4.1-flash-free#max",
      "mode": "primary",
      "description": "Bounded iPhone 4 Linux worker",
      "steps": 80,
      "permissions": [
        {
          "action": "*",
          "resource": "*",
          "effect": "ask"
        },
        {
          "action": "shell",
          "resource": "*",
          "effect": "allow"
        },
        {
          "action": "webfetch",
          "resource": "*",
          "effect": "allow"
        },
        {
          "action": "websearch",
          "resource": "*",
          "effect": "allow"
        }
      ]
    }
  },
  "watcher": {
    "ignore": [
      ".cache/**",
      "output/**",
      ".runtime/**"
    ]
  }
}
